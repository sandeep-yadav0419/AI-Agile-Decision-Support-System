# ==============================================================================
# AI-DSS AGILITY ENTERPRISE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=AI-Driven Autonomous Decision Support System
APP_VERSION=0.3.0
DEBUG=False

# Database Connection (SQLite local file or PostgreSQL in production)
# SQLite: sqlite:///./app.db
# PostgreSQL: postgresql://user:password@localhost:5432/aidss_db
DATABASE_URL=sqlite:///./app.db

# Cryptographic Keys (MUST rotate in production with `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-distinct-jwt-secret-key-in-production
CSRF_SECRET=replace-with-a-secure-csrf-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MFA_TICKET_EXPIRE_MINUTES=5

# Cookie & Session Security Flags
SESSION_COOKIE_NAME=aidss_session
CSRF_COOKIE_NAME=aidss_csrf
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Security Engine Toggles
ENABLE_RATE_LIMITING=True
ENABLE_SECURITY_HEADERS=True
ENABLE_HSTS=False

# Google OAuth 2.0 Identity Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# GitHub OAuth 2.0 Identity Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173

# CORS Allowed Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ai-agile-decision-support-system.vercel.app,https://ai-agile-decision-support-system.onrender.com

